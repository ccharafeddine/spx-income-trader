# E*TRADE API Credentials
# For sandbox testing, use sandbox credentials from E*TRADE developer portal
ETRADE_SANDBOX_KEY=your_sandbox_consumer_key
ETRADE_SANDBOX_SECRET=your_sandbox_consumer_secret

# For production (live trading)
ETRADE_CONSUMER_KEY=your_production_consumer_key
ETRADE_CONSUMER_SECRET=your_production_consumer_secret

# E*TRADE Account ID (same for sandbox and production)
ETRADE_ACCOUNT_ID=your_account_id_here

# Use sandbox mode (true for paper trading with E*TRADE sandbox API)
ETRADE_SANDBOX=true

# Trading Mode: paper (simulated) or live (real E*TRADE API)
TRADING_MODE=paper

